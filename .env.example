# Railway will auto-inject DATABASE_URL, REDIS_URL, PORT
# Only set these locally or in Railway Variables dashboard

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-me
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long-change-me

# Google OAuth (optional - for Sheets integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Frontend URL (Railway domain)
FRONTEND_URL=https://your-app.up.railway.app
API_URL=https://your-app.up.railway.app

# App
NODE_ENV=production
